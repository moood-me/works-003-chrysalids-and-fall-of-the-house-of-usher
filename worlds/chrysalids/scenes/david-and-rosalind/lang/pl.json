{"strings": [
  {"text":"David and Rosalind","translation":"David i Rosalind","where":"worlds/chrysalids/scenes/david-and-rosalind/scene.json title"},
  {"text":"In front of everyone we were strangers.","translation":"Przy wszystkich byliśmy sobie obcy.","where":"worlds/chrysalids/scenes/david-and-rosalind/scene.json caption"},
  {"text":"We did not look at each other.","translation":"Nie patrzyliśmy na siebie.","where":"worlds/chrysalids/scenes/david-and-rosalind/scene.json captions[0] text"},
  {"text":"Alone — only in our thoughts — we were together.","translation":"Sam na sam – tylko w myślach – byliśmy razem.","where":"worlds/chrysalids/scenes/david-and-rosalind/scene.json captions[1] text"}
]}
