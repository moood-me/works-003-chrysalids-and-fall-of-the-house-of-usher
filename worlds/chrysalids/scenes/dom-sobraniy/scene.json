      },
      {
        "text": "Low male voices humming a single drone note, stern congregation, no words",
        "weight": 1.5
      },
      {
        "text": "Solo cello sul tasto, one held low note, tension of a trial",
        "weight": 1.5
      },
      {
        "text": "Ticking clock and creaking benches in a wooden hall, faint lamp hiss, no melody",
        "weight": 1
      },
      {
        "text": "Dark ambient room tone, wind against shutters, distant dog barking",
        "weight": 0
      },
      {
        "text": "Slow timpani heartbeat, very soft, fear held under the surface",
        "weight": 0
      },
      {
        "text": "Minimal string quartet, sustained dissonant chords, cold and devout",
        "weight": 0
      },
      {
        "text": "Old upright piano, single low notes left to decay",
        "weight": 0
      },
      {
        "text": "Shaker hymn harmony on bowed strings, plain and severe",
        "weight": 0
      },
      {
        "text": "Bass clarinet low breaths, chamber silence",
        "weight": 0
      },
      {
        "text": "Distant crackle of a fire outside, rising murmur of alarm, sparse low strings",
        "weight": 0
      },
      {
        "text": "Hurdy-gurdy drone, ascetic and medieval",
        "weight": 0
      },
      {
        "text": "Glass harmonica tones, fragile, a child's thoughts heard mind to mind",
        "weight": 0
      },
      {
        "text": "Frame drum played with fingers, slow, ritual judgement",
        "weight": 0
      },
      {
        "text": "Frontier fiddle lament, far away, sparse",
